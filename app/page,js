    function generateCaptcha() {
      const num1 = Math.floor(Math.random() * 9) + 1;
      const num2 = Math.floor(Math.random() * 9) + 1;
      captchaResult = num1 + num2;
      document.getElementById('captcha-box').textContent = `${num1} + ${num2} = ?`;
      document.getElementById('captcha-input').value = '';
    }

    function handleRegister(e) {
      e.preventDefault();
      const email = document.getElementById('reg-email').value.trim();
      const whatsapp = document.getElementById('reg-whatsapp').value.trim();
      const password = document.getElementById('reg-password').value;
      const captchaVal = parseInt(document.getElementById('captcha-input').value);

      // STRICT GMAIL VALIDATION
      if (!isGmail(email)) {
        showToast('Pendaftaran hanya diperbolehkan menggunakan email Google (@gmail.com)', 'error');
        return;
      }

      if (captchaVal !== captchaResult) {
        showToast('CAPTCHA salah! Silakan hitung kembali.', 'error');
        generateCaptcha();
        return;
      }

      const existing = state.users.find(u => u.email.toLowerCase() === email.toLowerCase());
      if (existing) {
        showToast('Email Gmail ini sudah terdaftar. Silahkan login!', 'error');
        return;
      }

      const newUser = {
        id: 'usr_' + Date.now(),
        email: email,
        whatsapp: whatsapp,
        password: password,
        role: 'user',
        status: 'pending',
        createdAt: new Date().toISOString()
      };

      state.users.push(newUser);
      state.currentUser = newUser;
      saveState();

      showToast('Registrasi sukses! Menunggu approval Admin.', 'success');
      switchView('pending');
    }

    function handleLogin(e) {
      e.preventDefault();
      const identifier = document.getElementById('login-identifier').value.trim();
      const password = document.getElementById('login-password').value;

      const user = state.users.find(u => 
        (u.email.toLowerCase() === identifier.toLowerCase() || u.whatsapp === identifier) && 
        u.password === password
      );

      if (!user) {
        showToast('Email/WhatsApp atau Password salah!', 'error');
        return;
      }

      state.currentUser = user;
      saveState();

      showToast(`Selamat datang kembali, ${user.email}`, 'success');

      if (user.role === 'admin') {
        switchView('admin');
      } else if (user.status === 'approved' || user.status === 'frozen') {
        switchView('member');
      } else if (user.status === 'pending') {
        switchView('pending');
      } else {
        showToast('Akun Anda ditolak oleh Admin.', 'error');
