    function claimBenefit(benefitId) {
      const user = state.currentUser || state.users.find(u => u.status === 'approved' || u.status === 'frozen');
      if (!user) return;

      // STRICT FREEZE CHECK
      if (user.status === 'frozen') {
        showToast('Akses Anda telah dibekukan oleh Admin. Tidak dapat mengklaim benefit apapun!', 'error');
        return;
      }

      const ben = state.benefits.find(b => b.id === benefitId);
      if (!ben || ben.stock <= 0) {
        showToast('Stok benefit telah habis!', 'error');
        return;
      }

      const todayStr = getTodayDateStr();
      const claimsTodayCount = state.claims.filter(c => c.userId === user.id && c.benefitId === ben.id && c.claimedDate === todayStr).length;

      if (ben.dailyLimit > 0 && claimsTodayCount >= ben.dailyLimit) {
        showToast(`Batas klaim harian untuk benefit ini telah habis (${ben.dailyLimit}x/hari)`, 'error');
        return;
      }

      let claimedValueResult = '';

      if (ben.type === 'account') {
        if (!ben.accounts || ben.accounts.length === 0) {
          showToast('Stok akun habis!', 'error');
          return;
        }
        // Take first account & delete permanently from stock
        claimedValueResult = ben.accounts.shift();
        ben.stock = ben.accounts.length;
      } else {
        ben.stock -= 1;
        claimedValueResult = ben.accessUrl;
      }

      const newClaim = {
        id: 'clm_' + Date.now(),
        userId: user.id,
        userEmail: user.email,
        benefitId: ben.id,
        benefitTitle: ben.title,
        type: ben.type,
        claimedValue: claimedValueResult,
        claimedDate: todayStr,
        claimedAt: new Date().toISOString()
      };

      state.claims.push(newClaim);
      saveState();

      showToast('Berhasil mengklaim benefit!', 'success');
      renderMemberDashboard();

      if (ben.type === 'account') {
        openAccountResultModal(ben.title, claimedValueResult);
      } else {
        openLinkResultModal(ben.title, claimedValueResult);
      }
    }

    function openAccountResultModal(title, accountStr) {
      const parts = accountStr.split('|');
      const userPart = parts[0] || accountStr;
      const passPart = parts[1] || '';

      const container = document.getElementById('modal-container');
      const content = document.getElementById('modal-content');

      content.innerHTML = `
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-purple-500/20 text-purple-300 flex items-center justify-center mx-auto mb-3 border border-purple-500">
            <i data-lucide="key" class="w-6 h-6"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-1">Detail Akun & Password</h3>
          <p class="text-xs text-gray-300 mb-4">${title}</p>
          
          <div class="bg-[#120211] p-3 rounded-xl border border-gray-800 text-left font-mono text-xs space-y-2 mb-4">
            <div class="flex justify-between items-center">
              <span class="text-gray-400">Username/Email:</span>
              <span class="text-white font-bold select-all">${userPart}</span>
            </div>
            ${passPart ? `
              <div class="flex justify-between items-center border-t border-gray-800 pt-2">
                <span class="text-gray-400">Password:</span>
                <span class="text-[#F0C37A] font-bold select-all">${passPart}</span>
              </div>
            ` : ''}
          </div>

          <div class="flex gap-2 mb-3">
            <button onclick="copyToClipboard('${accountStr}', 'Format Email|Password disalin!')" class="flex-1 py-2.5 bg-[#E60070] hover:bg-[#C4005F] text-white font-semibold text-xs rounded-xl transition flex items-center justify-center gap-2">
              <i data-lucide="copy" class="w-4 h-4"></i> Salin Akun & Password
            </button>
          </div>

          <button onclick="closeModal()" class="text-xs text-gray-400 hover:underline">Tutup Modal</button>
        </div>
      `;

      container.classList.remove('hidden');
      lucide.createIcons();
    }

    function openLinkResultModal(title, url) {
      const container = document.getElementById('modal-container');
      const content = document.getElementById('modal-content');

      content.innerHTML = `
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-3 border border-emerald-500">
            <i data-lucide="check" class="w-6 h-6"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-1">Akses Link Benefit</h3>
          <p class="text-xs text-gray-300 mb-4">${title}</p>
          
          <div class="bg-[#120211] p-3 rounded-xl border border-gray-800 text-left font-mono text-xs text-gray-300 break-all mb-4">
            ${url}
          </div>

          <div class="flex gap-2 mb-3">
            <button onclick="copyToClipboard('${url}', 'Link disalin!')" class="flex-1 py-2.5 bg-[#2C0A29] hover:bg-[#E60070] border border-[#E60070]/40 text-white font-semibold text-xs rounded-xl transition flex items-center justify-center gap-2">
              <i data-lucide="copy" class="w-4 h-4"></i> Salin Link
            </button>
            <a href="${url}" target="_blank" class="flex-1 py-2.5 bg-[#E60070] hover:bg-[#C4005F] text-white font-semibold text-xs rounded-xl transition flex items-center justify-center gap-2">
              <i data-lucide="external-link" class="w-4 h-4"></i> Buka Link
            </a>
          </div>

          <button onclick="closeModal()" class="text-xs text-gray-400 hover:underline">Tutup Modal</button>
        </div>
      `;

      container.classList.remove('hidden');
      lucide.createIcons();
    }

    function closeModal() {
      document.getElementById('modal-container').classList.add('hidden');
    }


    // --- ADMIN PANEL LOGIC ---
    function switchAdminTab(tab) {
      document.getElementById('admin-tab-users').classList.toggle('hidden', tab !== 'users');
      document.getElementById('admin-tab-stock').classList.toggle('hidden', tab !== 'stock');
      document.getElementById('admin-tab-announce').classList.toggle('hidden', tab !== 'announce');
      document.getElementById('admin-tab-logs').classList.toggle('hidden', tab !== 'logs');
      document.getElementById('admin-tab-admin-pass').classList.toggle('hidden', tab !== 'admin-pass');

      ['users', 'stock', 'announce', 'logs', 'admin-pass'].forEach(t => {
        const btn = document.getElementById(`a-nav-${t}`);
        if (btn) btn.className = "w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-gray-300 hover:text-white hover:bg-[#120211] transition";
      });

      const activeBtn = document.getElementById(`a-nav-${tab}`);
      if (activeBtn) activeBtn.className = "w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-[#E60070] text-white transition";
    }

    function renderAdminDashboard() {
      const pendingCount = state.users.filter(u => u.status === 'pending').length;
      const approvedCount = state.users.filter(u => u.status === 'approved').length;
      const frozenCount = state.users.filter(u => u.status === 'frozen').length;

      document.getElementById('stat-pending-count').textContent = pendingCount;
      document.getElementById('stat-approved-count').textContent = approvedCount;
      document.getElementById('stat-frozen-count').textContent = frozenCount;
      document.getElementById('stat-benefits-count').textContent = state.benefits.length;

      // Fill Announcement form values
      document.getElementById('ann-title').value = state.announcement.title;
      document.getElementById('ann-content').value = state.announcement.content;
      document.getElementById('ann-url').value = state.announcement.groupUrl;
      document.getElementById('ann-enabled').checked = state.announcement.enabled;

      renderAdminUsersTable();
      renderAdminBenefitsTable();
      renderAdminLogsTable();
    }

    function renderAdminUsersTable() {
      const tbody = document.getElementById('admin-users-tbody');
      const search = document.getElementById('admin-search-user').value.toLowerCase();
      const filterStatus = document.getElementById('admin-filter-status').value;

      tbody.innerHTML = '';

      let filtered = state.users.filter(u => u.role !== 'admin');

      if (filterStatus !== 'all') {
        filtered = filtered.filter(u => u.status === filterStatus);
      }

      if (search) {
        filtered = filtered.filter(u => u.email.toLowerCase().includes(search) || u.whatsapp.includes(search));
      }

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-gray-500">Tidak ada pendaftar ditemukan.</td></tr>`;
        return;
      }

      filtered.forEach(u => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-white/5 transition";

        let statusBadge = '';
        if (u.status === 'approved') {
          statusBadge = `<span class="px-2 py-0.5 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded font-mono text-[10px]">Approved</span>`;
        } else if (u.status === 'pending') {
          statusBadge = `<span class="px-2 py-0.5 bg-[#F0C37A]/20 text-[#F0C37A] border border-[#F0C37A]/30 rounded font-mono text-[10px]">Pending</span>`;
        } else if (u.status === 'frozen') {
          statusBadge = `<span class="px-2 py-0.5 bg-red-500/20 text-red-400 border border-red-500/40 rounded font-mono text-[10px] font-bold">Dibekukan (Frozen)</span>`;
        } else {
          statusBadge = `<span class="px-2 py-0.5 bg-gray-500/20 text-gray-400 border border-gray-500/30 rounded font-mono text-[10px]">Rejected</span>`;
        }

        const waMsg = encodeURIComponent(`Halo, pemberitahuan mengenai akun BUKAN HANNZ Anda (${u.email}). Status akun: ${u.status.toUpperCase()}.`);

        tr.innerHTML = `
          <td class="p-3 font-semibold text-white">${u.email}</td>
          <td class="p-3 font-mono text-gray-300">
            <a href="https://wa.me/${u.whatsapp}?text=${waMsg}" target="_blank" class="text-emerald-400 hover:underline flex items-center gap-1">
              <i data-lucide="phone" class="w-3 h-3"></i> ${u.whatsapp}
            </a>
          </td>
          <td class="p-3 text-gray-400 font-mono">${new Date(u.createdAt).toLocaleDateString('id-ID')}</td>
          <td class="p-3">${statusBadge}</td>
          <td class="p-3 text-right space-x-1">
            ${u.status === 'pending' ? `
              <button onclick="setUserStatus('${u.id}', 'approved')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-[11px] font-semibold transition">
                Approve
              </button>
              <button onclick="setUserStatus('${u.id}', 'rejected')" class="px-2.5 py-1 bg-gray-700 hover:bg-gray-600 text-white rounded-lg text-[11px] font-semibold transition">
                Tolak
              </button>
            ` : ''}

            ${u.status === 'approved' ? `
              <button onclick="setUserStatus('${u.id}', 'frozen')" class="px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white rounded-lg text-[11px] font-semibold transition flex-inline items-center gap-1" title="Membekukan dan mencabut akses klaim semua benefit user">
                <i data-lucide="user-x" class="w-3 h-3 inline"></i> Cabut Akses (Freeze)
              </button>
            ` : ''}

            ${u.status === 'frozen' ? `
              <button onclick="setUserStatus('${u.id}', 'approved')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-[11px] font-semibold transition flex-inline items-center gap-1">
                <i data-lucide="check-circle" class="w-3 h-3 inline"></i> Pulihkan Akses
              </button>
            ` : ''}
          </td>
        `;
        tbody.appendChild(tr);
      });

      lucide.createIcons();
    }

    function setUserStatus(userId, status) {
      const user = state.users.find(u => u.id === userId);
      if (user) {
        user.status = status;
        saveState();

        if (status === 'frozen') {
          showToast(`Akses user ${user.email} berhasil DICABUT (DIBEKUKAN)`, 'error');
        } else if (status === 'approved') {
          showToast(`User ${user.email} disetujui / dipulihkan aksesnya`, 'success');
        } else {
          showToast(`Status user ${user.email} di-update ke ${status.toUpperCase()}`, 'info');
        }

        renderAdminDashboard();
      }
    }

    function handleAdminChangePassword(e) {
      e.preventDefault();
      const adminUser = state.users.find(u => u.role === 'admin');
      if (!adminUser) return;

      const oldPass = document.getElementById('a-old-pass').value;
      const newPass = document.getElementById('a-new-pass').value;
      const confirmPass = document.getElementById('a-confirm-pass').value;

      if (adminUser.password !== oldPass) {
        showToast('Password Admin saat ini salah!', 'error');
        return;
      }

      if (newPass !== confirmPass) {
        showToast('Konfirmasi password baru Admin tidak cocok!', 'error');
        return;
      }

      adminUser.password = newPass;
      if (state.currentUser && state.currentUser.role === 'admin') {
        state.currentUser.password = newPass;
      }

      saveState();
      e.target.reset();
      showToast('Password Admin berhasil diperbarui!', 'success');
    }

    // Toggle Input form when adding Benefit
    function toggleBenefitInputFields() {
      const type = document.getElementById('add-ben-type').value;
      const fieldLink = document.getElementById('field-type-link');
      const fieldAccount = document.getElementById('field-type-account');

      if (type === 'link') {
        fieldLink.classList.remove('hidden');
        fieldAccount.classList.add('hidden');
      } else {
        fieldLink.classList.add('hidden');
        fieldAccount.classList.remove('hidden');
      }
    }

    function updateAccountLineCount() {
      const text = document.getElementById('add-ben-accounts').value;
      const lines = text.split('\n').filter(l => l.trim().length > 0);
      document.getElementById('account-line-count').textContent = `${lines.length} Akun Terdeteksi`;
    }

    function handleAddBenefit(e) {
      e.preventDefault();
      const title = document.getElementById('add-ben-title').value.trim();
      const type = document.getElementById('add-ben-type').value;
      const dailyLimit = parseInt(document.getElementById('add-ben-limit').value);
      const desc = document.getElementById('add-ben-desc').value.trim();

      let accountsArr = [];
      let url = '';
      let stock = 0;

      if (type === 'account') {
        const text = document.getElementById('add-ben-accounts').value;
        accountsArr = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
        stock = accountsArr.length;

        if (stock === 0) {
          showToast('Masukkan minimal 1 baris akun!', 'error');
          return;
        }
      } else {
        url = document.getElementById('add-ben-url').value.trim();
        stock = parseInt(document.getElementById('add-ben-link-stock').value) || 10;

        if (!url) {
          showToast('Masukkan link URL akses!', 'error');
          return;
        }
      }

      const newBen = {
        id: 'ben_' + Date.now(),
        title: title,
        description: desc,
        type: type,
        accounts: accountsArr,
        accessUrl: url,
        stock: stock,
        maxStock: stock,
        dailyLimit: dailyLimit
      };

      state.benefits.push(newBen);
      saveState();

      showToast('Benefit baru berhasil ditambahkan!', 'success');
      e.target.reset();
      toggleBenefitInputFields();
      renderAdminDashboard();
    }

    function renderAdminBenefitsTable() {
      const tbody = document.getElementById('admin-benefits-tbody');
      tbody.innerHTML = '';

      state.benefits.forEach(ben => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-white/5 transition";

        const typeBadge = ben.type === 'account' ? '<span class="text-purple-400 font-mono">AKUN</span>' : '<span class="text-blue-400 font-mono">LINK</span>';
        const limitStr = ben.dailyLimit > 0 ? `${ben.dailyLimit}x / Hari` : 'Bebas';

        tr.innerHTML = `
          <td class="p-3 font-semibold text-white">
            ${ben.title}
            <div class="text-[10px] text-gray-400 font-normal">${ben.description}</div>
          </td>
          <td class="p-3 text-[11px]">${typeBadge}</td>
          <td class="p-3 font-mono text-[#F0C37A] text-[11px]">${limitStr}</td>
          <td class="p-3 font-mono font-bold text-white">${ben.stock}</td>
          <td class="p-3 text-right space-x-1">
            <button onclick="deleteBenefit('${ben.id}')" class="px-2.5 py-1 bg-red-950 hover:bg-red-800 text-red-200 border border-red-500/30 rounded-lg text-[11px] transition">
              Hapus
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function deleteBenefit(benId) {
      state.benefits = state.benefits.filter(b => b.id !== benId);
      saveState();
      showToast('Benefit berhasil dihapus', 'info');
      renderAdminDashboard();
    }

    function handleSaveAnnouncement(e) {
      e.preventDefault();
      state.announcement = {
        title: document.getElementById('ann-title').value.trim(),
        content: document.getElementById('ann-content').value.trim(),
        groupUrl: document.getElementById('ann-url').value.trim(),
        enabled: document.getElementById('ann-enabled').checked
      };

      saveState();
      showToast('Pengaturan Popup Info & Link Grup berhasil disimpan!', 'success');
    }

    function renderAdminLogsTable() {
      const tbody = document.getElementById('admin-logs-tbody');
      tbody.innerHTML = '';

      if (state.claims.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-gray-500">Belum ada klaim dari pengguna.</td></tr>`;
        return;
      }

      state.claims.slice().reverse().forEach(log => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-white/5 transition";
        tr.innerHTML = `
          <td class="p-3 font-mono text-white">${log.userEmail}</td>
          <td class="p-3 font-semibold text-[#F0C37A]">${log.benefitTitle}</td>
          <td class="p-3 font-mono text-[10px] uppercase">${log.type}</td>
          <td class="p-3 font-mono text-gray-300 text-[11px] max-w-[180px] truncate">${log.claimedValue}</td>
          <td class="p-3 font-mono text-gray-400">${new Date(log.claimedAt).toLocaleString('id-ID')}</td>
        `;
        tbody.appendChild(tr);
      });
    }


    // --- TOAST & CLIPBOARD HELPERS ---
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');

      let bgClass = "bg-[#2C0A29] border-[#E60070] text-white";
      if (type === 'success') bgClass = "bg-emerald-950 border-emerald-500 text-emerald-200";
      if (type === 'error') bgClass = "bg-red-950 border-red-500 text-red-200";

      toast.className = `p-3.5 rounded-xl border shadow-2xl text-xs font-semibold flex items-center justify-between gap-2 pointer-events-auto transition duration-300 ${bgClass}`;
      toast.innerHTML = `
        <span>${message}</span>
        <button onclick="this.parentElement.remove()" class="text-gray-400 hover:text-white">&times;</button>
      `;

      container.appendChild(toast);

      setTimeout(() => {
        toast.remove();
      }, 4000);
    }

    function copyToClipboard(text, successMsg = 'Text berhasil disalin!') {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      document.body.appendChild(textArea);
      textArea.select();
      try {
        document.execCommand('copy');
        showToast(successMsg, 'success');
      } catch (err) {
        showToast('Gagal menyalin text.', 'error');
      }
      document.body.removeChild(textArea);
    }
  </script>
</body>
</html>
