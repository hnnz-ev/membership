<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BUKAN HANNZ - Cyber Membership VIP</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <!-- Google Fonts: Rajdhani & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              bg: '#1D031B',
              card: '#2C0A29',
              primary: '#E60070',
              primaryHover: '#C4005F',
              gold: '#F0C37A',
              goldHover: '#dca85b',
              cyberDark: '#120211'
            }
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            cyber: ['Rajdhani', 'sans-serif']
          }
        }
      }
    }
  </script>

  <style>
    /* Background grid effect cyber anime */
    body {
      background-color: #1D031B;
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(230, 0, 112, 0.18) 0%, transparent 65%),
        linear-gradient(to right, rgba(230, 0, 112, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(230, 0, 112, 0.05) 1px, transparent 1px);
      background-size: 100% 100%, 32px 32px, 32px 32px;
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #F3F4F6;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #120211;
    }
    ::-webkit-scrollbar-thumb {
      background: #E60070;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #F0C37A;
    }

    /* Glowing borders and text */
    .neon-border {
      box-shadow: 0 0 18px rgba(230, 0, 112, 0.28);
    }
    .neon-border-gold {
      box-shadow: 0 0 18px rgba(240, 195, 122, 0.28);
    }
    .neon-border-red {
      box-shadow: 0 0 20px rgba(239, 68, 68, 0.4);
    }
    .neon-text {
      text-shadow: 0 0 12px rgba(230, 0, 112, 0.7);
    }
    .glass-panel {
      background: rgba(44, 10, 41, 0.88);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(230, 0, 112, 0.25);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased selection:bg-[#E60070] selection:text-white">

  <!-- ==================== TOP DEMO NAVIGATION BAR (SWITCHER) ==================== -->
  <header id="demo-nav" class="sticky top-0 z-40 bg-[#120211]/95 backdrop-blur-md border-b border-[#E60070]/30 px-4 py-2 text-xs">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#E60070] animate-ping"></span>
        <span class="font-cyber font-bold text-sm text-[#F0C37A] tracking-wider uppercase">DEMO CONTROLLER:</span>
        <span id="current-role-badge" class="bg-[#E60070]/20 text-[#E60070] border border-[#E60070]/40 px-2 py-0.5 rounded font-mono font-semibold">
          Auth View
        </span>
      </div>

      <div class="flex items-center flex-wrap gap-2">
        <button onclick="switchView('auth')" class="demo-btn px-3 py-1 rounded-lg bg-[#2C0A29] hover:bg-[#E60070] text-white border border-[#E60070]/30 transition font-medium">
          <i data-lucide="log-in" class="w-3.5 h-3.5 inline mr-1"></i> Form Auth
        </button>
        <button onclick="switchView('pending')" class="demo-btn px-3 py-1 rounded-lg bg-[#2C0A29] hover:bg-[#E60070] text-white border border-[#E60070]/30 transition font-medium">
          <i data-lucide="clock" class="w-3.5 h-3.5 inline mr-1"></i> Pending Page
        </button>
        <button onclick="setDemoUserMode('approved')" class="demo-btn px-3 py-1 rounded-lg bg-[#2C0A29] hover:bg-[#E60070] text-white border border-[#E60070]/30 transition font-medium">
          <i data-lucide="user-check" class="w-3.5 h-3.5 inline mr-1"></i> Member Aktif
        </button>
        <button onclick="setDemoUserMode('frozen')" class="demo-btn px-3 py-1 rounded-lg bg-red-950/80 hover:bg-red-800 text-red-200 border border-red-500/50 transition font-medium">
          <i data-lucide="user-x" class="w-3.5 h-3.5 inline mr-1"></i> Member Dibekukan
        </button>
        <button onclick="switchView('admin')" class="demo-btn px-3 py-1 rounded-lg bg-[#2C0A29] hover:bg-[#F0C37A] hover:text-black text-white border border-[#F0C37A]/40 transition font-medium">
          <i data-lucide="shield" class="w-3.5 h-3.5 inline mr-1"></i> Panel Admin
        </button>
        
        <div class="h-4 w-px bg-gray-700 mx-1 hidden sm:block"></div>
        <button onclick="resetDataToDefault()" title="Reset data simulasi ke awal" class="px-2 py-1 rounded-lg bg-red-950/60 hover:bg-red-800 text-red-200 border border-red-500/40 transition font-mono text-[10px]">
          <i data-lucide="rotate-ccw" class="w-3 h-3 inline"></i> Reset State
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== NOTIFICATION TOAST CONTAINER ==================== -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

  <!-- ==================== MAIN CONTENT CONTAINER ==================== -->
  <main class="flex-grow flex flex-col">

    <!-- ------------------------------------------------------------------ -->
    <!-- VIEW 1: AUTHENTICATION (REGISTER / LOGIN)                          -->
    <!-- ------------------------------------------------------------------ -->
    <section id="view-auth" class="flex-grow flex items-center justify-center p-4 py-10">
      <div class="w-full max-w-md glass-panel rounded-2xl p-6 sm:p-8 neon-border relative overflow-hidden">
        <div class="absolute top-0 right-0 w-24 h-24 bg-[#E60070]/10 rounded-bl-full pointer-events-none"></div>
        
        <div class="text-center mb-6">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-[#E60070]/10 border border-[#E60070] mb-3 text-[#E60070]">
            <i data-lucide="sparkles" class="w-7 h-7"></i>
          </div>
          <h1 class="text-2xl font-cyber font-bold tracking-wider text-white neon-text uppercase">BUKAN HANNZ</h1>
          <p class="text-xs text-gray-400 mt-1">Sistem Eksklusif Membership Anime & Creator Kit</p>
        </div>

        <!-- Auth Tabs -->
        <div class="flex bg-[#120211] p-1 rounded-xl mb-6 border border-gray-800">
          <button id="tab-btn-register" onclick="switchAuthTab('register')" class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 bg-[#E60070] text-white shadow">
            Daftar Member
          </button>
          <button id="tab-btn-login" onclick="switchAuthTab('login')" class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 text-gray-400 hover:text-white">
            Login Member
          </button>
        </div>

        <!-- FORM REGISTRASI -->
        <form id="form-register" onsubmit="handleRegister(event)" class="space-y-4">
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="block text-xs font-medium text-gray-300">Email Google (@gmail.com)</label>
              <span class="text-[10px] text-[#F0C37A] font-mono">Strictly Gmail</span>
            </div>
            <div class="relative">
              <i data-lucide="mail" class="w-4 h-4 absolute left-3 top-3 text-gray-500"></i>
              <input type="email" id="reg-email" oninput="validateGmailInput(this)" required placeholder="namamu@gmail.com" class="w-full bg-[#120211] border border-gray-800 rounded-xl py-2.5 pl-9 pr-3 text-xs focus:border-[#E60070] focus:ring-1 focus:ring-[#E60070] outline-none text-white transition">
            </div>
            <p id="gmail-error-msg" class="text-[11px] text-red-400 mt-1 hidden flex items-center gap-1">
              <i data-lucide="alert-circle" class="w-3 h-3"></i> Pendaftaran hanya diperbolehkan menggunakan email Google (@gmail.com)
            </p>
          </div>

          <div>
            <label class="block text-xs font-medium text-gray-300 mb-1">Nomor WhatsApp (Aktif)</label>
            <div class="relative">
              <i data-lucide="phone" class="w-4 h-4 absolute left-3 top-3 text-gray-500"></i>
              <input type="tel" id="reg-whatsapp" required placeholder="081234567890" class="w-full bg-[#120211] border border-gray-800 rounded-xl py-2.5 pl-9 pr-3 text-xs focus:border-[#E60070] focus:ring-1 focus:ring-[#E60070] outline-none text-white transition">
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-gray-300 mb-1">Password</label>
            <div class="relative">
              <i data-lucide="lock" class="w-4 h-4 absolute left-3 top-3 text-gray-500"></i>
              <input type="password" id="reg-password" required minlength="6" placeholder="••••••••" class="w-full bg-[#120211] border border-gray-800 rounded-xl py-2.5 pl-9 pr-3 text-xs focus:border-[#E60070] focus:ring-1 focus:ring-[#E60070] outline-none text-white transition">
            </div>
          </div>

          <!-- INTERACTIVE CAPTCHA -->
          <div class="bg-[#120211] border border-gray-800 rounded-xl p-3 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs text-gray-400">Verifikasi Keamanan (CAPTCHA)</span>
              <button type="button" onclick="generateCaptcha()" class="text-[10px] text-[#F0C37A] hover:underline flex items-center gap-1">
                <i data-lucide="refresh-cw" class="w-3 h-3"></i> Acak
              </button>
            </div>
            <div class="flex items-center gap-3">
              <div id="captcha-box" class="bg-[#2C0A29] text-[#F0C37A] font-mono font-bold text-sm px-4 py-2 rounded-lg border border-[#F0C37A]/30 tracking-widest select-none">
                8 + 4 = ?
              </div>
              <input type="number" id="captcha-input" required placeholder="Hasil" class="flex-1 bg-[#1D031B] border border-gray-800 rounded-lg py-2 px-3 text-xs text-center focus:border-[#E60070] outline-none text-white font-mono">
            </div>
          </div>

          <button type="submit" class="w-full py-3 bg-[#E60070] hover:bg-[#C4005F] text-white font-semibold text-xs uppercase tracking-wider rounded-xl shadow-lg transition duration-200 flex items-center justify-center gap-2">
            <i data-lucide="user-plus" class="w-4 h-4"></i> Daftar Sekarang
          </button>
        </form>

        <!-- FORM LOGIN -->
        <form id="form-login" onsubmit="handleLogin(event)" class="space-y-4 hidden">
          <div>
            <label class="block text-xs font-medium text-gray-300 mb-1">Email / WhatsApp</label>
            <div class="relative">
              <i data-lucide="user" class="w-4 h-4 absolute left-3 top-3 text-gray-500"></i>
              <input type="text" id="login-identifier" required placeholder="Email atau No. WA" class="w-full bg-[#120211] border border-gray-800 rounded-xl py-2.5 pl-9 pr-3 text-xs focus:border-[#E60070] focus:ring-1 focus:ring-[#E60070] outline-none text-white transition">
            </div>
          </div>

          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="block text-xs font-medium text-gray-300">Password</label>
              <button type="button" onclick="openForgotPasswordModal()" class="text-[11px] text-[#F0C37A] hover:underline">Lupa Password?</button>
            </div>
            <div class="relative">
              <i data-lucide="lock" class="w-4 h-4 absolute left-3 top-3 text-gray-500"></i>
              <input type="password" id="login-password" required placeholder="••••••••" class="w-full bg-[#120211] border border-gray-800 rounded-xl py-2.5 pl-9 pr-3 text-xs focus:border-[#E60070] focus:ring-1 focus:ring-[#E60070] outline-none text-white transition">
            </div>
          </div>

          <div class="text-right">
            <span class="text-[11px] text-gray-500">Akun Admin Default: <code class="text-[#F0C37A]">admin@bukanhannz.com</code> / <code class="text-[#F0C37A]">admin123</code></span>
          </div>

          <button type="submit" class="w-full py-3 bg-[#E60070] hover:bg-[#C4005F] text-white font-semibold text-xs uppercase tracking-wider rounded-xl shadow-lg transition duration-200 flex items-center justify-center gap-2">
            <i data-lucide="log-in" class="w-4 h-4"></i> Masuk Ke Akun
          </button>
        </form>
      </div>
    </section>


    <!-- ------------------------------------------------------------------ -->
    <!-- VIEW 2: PENDING APPROVAL SCREEN                                    -->
    <!-- ------------------------------------------------------------------ -->
    <section id="view-pending" class="flex-grow flex items-center justify-center p-4 py-10 hidden">
      <div class="w-full max-w-lg glass-panel rounded-2xl p-6 sm:p-8 text-center neon-border-gold relative">
        <div class="w-16 h-16 rounded-full bg-[#F0C37A]/10 border border-[#F0C37A] flex items-center justify-center mx-auto mb-4 text-[#F0C37A] animate-pulse">
          <i data-lucide="hourglass" class="w-8 h-8"></i>
        </div>

        <span class="inline-block px-3 py-1 bg-[#F0C37A]/20 text-[#F0C37A] border border-[#F0C37A]/40 rounded-full text-xs font-mono font-semibold mb-3">
          STATUS: MENUNGGU VERIFIKASI
        </span>

        <h2 class="text-2xl font-cyber font-bold text-white mb-2">Pendaftaran Berhasil Dikirim!</h2>
        <p class="text-xs text-gray-300 leading-relaxed max-w-md mx-auto mb-6">
          Akun kamu saat ini sedang dalam antrean peninjauan manual oleh Admin. Setelah disetujui, kamu bisa mengklaim semua benefit preset & akun VIP yang tersedia.
        </p>

        <!-- User Registered Detail Card -->
        <div class="bg-[#120211] rounded-xl p-4 border border-gray-800 text-left mb-6 text-xs space-y-2">
          <div class="flex justify-between border-b border-gray-800/80 pb-2">
            <span class="text-gray-400">Email:</span>
            <span id="pending-user-email" class="font-mono text-white font-semibold">user@gmail.com</span>
          </div>
          <div class="flex justify-between border-b border-gray-800/80 pb-2">
            <span class="text-gray-400">WhatsApp:</span>
            <span id="pending-user-wa" class="font-mono text-white font-semibold">08123456789</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-400">Waktu Daftar:</span>
            <span id="pending-user-time" class="text-gray-300 font-mono">Baru saja</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a id="pending-wa-link" href="#" target="_blank" class="flex-1 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl transition flex items-center justify-center gap-2">
            <i data-lucide="message-square" class="w-4 h-4"></i> Konfirmasi WA Admin
          </a>
          <button onclick="checkPendingApprovalStatus()" class="flex-1 py-3 px-4 bg-[#2C0A29] hover:bg-[#E60070] border border-[#E60070]/40 text-white font-semibold text-xs rounded-xl transition flex items-center justify-center gap-2">
            <i data-lucide="refresh-cw" class="w-4 h-4"></i> Cek Status Sekarang
          </button>
        </div>
      </div>
    </section>


    <!-- ------------------------------------------------------------------ -->
    <!-- VIEW 3: MEMBER DASHBOARD                                           -->
    <!-- ------------------------------------------------------------------ -->
    <section id="view-member" class="flex-grow flex flex-col md:flex-row hidden">
      <!-- Member Sidebar -->
      <aside class="w-full md:w-64 bg-[#2C0A29]/90 border-r border-[#E60070]/30 p-5 flex flex-col justify-between shrink-0">
        <div>
          <!-- Brand -->
          <div class="flex items-center gap-3 mb-8">
            <div class="w-10 h-10 rounded-xl bg-[#E60070] flex items-center justify-center text-white font-bold text-lg font-cyber">
              BH
            </div>
            <div>
              <h2 class="font-cyber font-bold text-lg text-white leading-tight">BUKAN HANNZ</h2>
              <span class="text-[10px] text-[#F0C37A] font-mono tracking-widest uppercase">MEMBER AREA VIP</span>
            </div>
          </div>

          <!-- User Badge Card -->
          <div id="member-status-card" class="bg-[#120211] p-3 rounded-xl border border-emerald-500/30 mb-6 flex items-center gap-3">
            <div id="member-status-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
            <div class="overflow-hidden">
              <div id="member-display-name" class="text-xs font-semibold text-white truncate">member@gmail.com</div>
              <span id="member-status-text" class="text-[10px] text-emerald-400 font-mono">Status: Active VIP</span>
            </div>
          </div>

          <!-- Navigation Links -->
          <nav class="space-y-1.5">
            <button onclick="switchMemberTab('benefits')" id="m-nav-benefits" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-[#E60070] text-white transition">
              <i data-lucide="gift" class="w-4 h-4"></i> Katalog Benefit
            </button>
            <button onclick="switchMemberTab('history')" id="m-nav-history" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-gray-300 hover:text-white hover:bg-[#120211] transition">
              <i data-lucide="history" class="w-4 h-4"></i> Riwayat Klaim Saya
            </button>
            <button onclick="switchMemberTab('password')" id="m-nav-password" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-gray-300 hover:text-white hover:bg-[#120211] transition">
              <i data-lucide="key-round" class="w-4 h-4"></i> Ganti Password
            </button>
          </nav>

          <!-- Group Diskusi Widget -->
          <div class="mt-6 p-3 bg-[#120211] border border-[#F0C37A]/30 rounded-xl space-y-2">
            <div class="text-[11px] font-bold text-[#F0C37A] flex items-center gap-1.5">
              <i data-lucide="users" class="w-3.5 h-3.5"></i> Grup Info Stok
            </div>
            <p class="text-[10px] text-gray-400">Dapatkan notifikasi restok akun & preset secara realtime.</p>
            <a id="sidebar-group-url" href="#" target="_blank" class="w-full block py-1.5 text-center bg-[#F0C37A] hover:bg-[#dca85b] text-black font-bold text-[10px] rounded-lg transition">
              Join Grup WA / Telegram
            </a>
          </div>
        </div>

        <button onclick="handleLogout()" class="mt-8 flex items-center gap-2 px-3 py-2 text-xs font-semibold text-red-400 hover:text-red-300 hover:bg-red-950/40 rounded-xl transition">
          <i data-lucide="log-out" class="w-4 h-4"></i> Keluar Akun
        </button>
      </aside>

      <!-- Member Content -->
      <main class="flex-grow p-4 sm:p-8 space-y-6">

        <!-- PROMINENT WARNING BANNER IF USER ACCESS IS REVOKED (FROZEN) -->
        <div id="frozen-warning-banner" class="hidden bg-red-950/90 border-2 border-red-500 text-white p-5 rounded-2xl neon-border-red flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-red-500/20 border border-red-500 flex items-center justify-center text-red-400 shrink-0">
              <i data-lucide="shield-alert" class="w-7 h-7"></i>
            </div>
            <div>
              <h3 class="text-sm font-bold text-red-200 uppercase tracking-wider font-cyber">AKSES DICABUT (AKUN DIBEKUKAN)</h3>
              <p class="text-xs text-red-300 mt-0.5">Akses klaim Anda telah dibekukan secara menyeluruh oleh Admin. Anda tidak dapat mengklaim benefit apapun di panel ini.</p>
            </div>
          </div>
          <a id="frozen-wa-confirm" href="#" target="_blank" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-xl shrink-0 transition flex items-center gap-2 shadow-lg">
            <i data-lucide="message-square" class="w-4 h-4"></i> Hubungi Admin
          </a>
        </div>

        <!-- Banner Welcome -->
        <div class="glass-panel p-6 rounded-2xl border border-[#E60070]/30 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 relative overflow-hidden">
          <div class="z-10">
            <h1 class="text-2xl font-cyber font-bold text-white">Selamat Datang, VIP Member!</h1>
            <p class="text-xs text-gray-300 mt-1">Silahkan klaim akun premium, preset, dan template yang tersedia di bawah ini.</p>
          </div>
          <div class="z-10 flex gap-2">
            <button onclick="triggerAnnouncementModal()" class="bg-[#120211] hover:bg-[#2C0A29] px-3.5 py-2 rounded-xl border border-[#F0C37A]/40 text-[#F0C37A] text-xs font-semibold transition flex items-center gap-2">
              <i data-lucide="bell" class="w-4 h-4"></i> Pengumuman
            </button>
            <div class="bg-[#120211] px-4 py-2 rounded-xl border border-[#E60070]/30 text-right">
              <div class="text-[10px] text-gray-400">Diklaim Hari Ini</div>
              <div id="user-today-claim-count" class="text-lg font-bold font-mono text-[#E60070]">0 Item</div>
            </div>
          </div>
        </div>

        <!-- TAB CONTENT 1: BENEFIT CATALOG -->
        <div id="member-tab-benefits">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <i data-lucide="sparkles" class="w-4 h-4 text-[#E60070]"></i> Katalog Benefit VIP Available
            </h3>
            <span class="text-xs text-gray-400 font-mono flex items-center gap-1">
              <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-400"></i> Protected Anti-Dump Limit
            </span>
          </div>

          <!-- Benefits Grid -->
          <div id="benefits-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <!-- Dynamic JS Injected Benefits -->
          </div>
        </div>

        <!-- TAB CONTENT 2: CLAIM HISTORY -->
        <div id="member-tab-history" class="hidden">
          <h3 class="text-sm font-bold text-white mb-4 flex items-center gap-2">
            <i data-lucide="history" class="w-4 h-4 text-[#F0C37A]"></i> Riwayat Akses & Akun Diklaim
          </h3>
          <div class="glass-panel rounded-2xl p-4 border border-gray-800 overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-gray-800 text-gray-400 font-mono uppercase">
                <tr>
                  <th class="p-3">Nama Benefit</th>
                  <th class="p-3">Tipe</th>
